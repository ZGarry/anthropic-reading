{
  "name": "anthropic-reading-directory",
  "private": true,
  "version": "1.0.0",
  "engines": {"node": ">=24.12.0"},
  "scripts": {
    "build": "node scripts/build_cloud.cjs",
    "test": "node scripts/check_progress.cjs && node --test tests/cloud-model.test.cjs tests/sync-engine.test.mjs tests/reader-accounts.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-reading-tests --only firestore \"node --test tests/firestore-rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.33.0",
    "jsdom": "29.1.1"
  }
}
